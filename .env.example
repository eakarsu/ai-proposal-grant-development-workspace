# Proposal & Grant Development Workspace — local development environment
DATABASE_URL='postgresql://postgres@127.0.0.1:5432/direct_517_ai_proposal_grant_development_workspace'
NEXTAUTH_SECRET="replace-with-a-random-secret-generated-by-openssl-rand-hex-32"
NEXTAUTH_URL=http://localhost:4629
CORS_ORIGINS=http://localhost:4629
NODE_ENV=development

# OpenRouter (server-side only; the browser never sees this key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI row context: DB rows attached to every AI call (0-5000, default 3000)
AI_CONTEXT_ROWS=3000
AI_CONTEXT_CHARS=120000

# Optional local demo records, added without replacing existing data.
LOAD_DEMO_DATA=false

# Optional basename of a font in assets/grant-fonts (WOFF/TTF/OTF).
GRANT_PDF_FONT_FILE=NotoSans.woff
