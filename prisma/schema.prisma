// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  authVersion Int @default(1)
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model Opportunity {
  id        String   @id @default(cuid())
  name String
  funder String
  program String
  awardCeiling Float
  status String
  deadline DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proposals Proposal[]
  requirementItems RequirementItem[]
  sourceDocuments SourceDocument[]
  claimValidations ClaimValidation[]
  budgetLines BudgetLine[]
  reviewerAssignments ReviewerAssignment[]
  deadlineItems DeadlineItem[]
  draftSections DraftSection[]
  meetingExtracts MeetingExtract[]
  submissionPackages SubmissionPackage[]
  complianceChecks ComplianceCheck[]
}

model Proposal {
  id        String   @id @default(cuid())
  title String
  opportunityRef String
  lead String
  requestedAmount Float
  status String
  dueDate DateTime?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequirementItem {
  id        String   @id @default(cuid())
  section String
  requirement String
  responseRef String
  status String
  owner String
  pageLimit String?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SourceDocument {
  id        String   @id @default(cuid())
  title String
  kind String
  storageRef String
  approvedBy String
  status String
  ingestedAt DateTime?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClaimValidation {
  id        String   @id @default(cuid())
  claim String
  sourceRef String
  verdict String
  reviewer String
  status String
  checkedAt DateTime?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetLine {
  id        String   @id @default(cuid())
  category String
  description String
  amount Float
  justification String
  status String
  allowability String
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewerAssignment {
  id        String   @id @default(cuid())
  reviewer String
  section String
  expertise String
  status String
  dueDate DateTime?
  feedbackRef String?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeadlineItem {
  id        String   @id @default(cuid())
  kind String
  title String
  dueAt DateTime?
  owner String
  status String
  consequence String?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftSection {
  id        String   @id @default(cuid())
  section String
  content String
  version String
  author String
  status String
  lastEditedAt DateTime?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingExtract {
  id        String   @id @default(cuid())
  meeting String
  keyPoints String
  decisions String
  actions String
  status String
  heldAt DateTime?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubmissionPackage {
  id        String   @id @default(cuid())
  portal String
  packageRef String
  status String
  submittedAt DateTime?
  confirmation String?
  pageCount Int
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceCheck {
  id        String   @id @default(cuid())
  rule String
  result String
  evidence String
  reviewer String
  status String
  checkedAt DateTime?
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model GrantOrganization {
 id String @id @default(cuid())
 name String
 profile String @default("")
 timezone String @default("America/New_York")
 reviewCount Int @default(2)
 version Int @default(1)
 createdAt DateTime @default(now())
 memberships GrantMembership[]
 projects GrantProject[]
 invites GrantInvitation[]
}
model GrantMembership {
 id String @id @default(cuid())
 organizationId String
 organization GrantOrganization @relation(fields:[organizationId],references:[id])
 userId String
 role String
 active Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([organizationId,userId])
 @@index([userId,active])
}
model GrantInvitation {
 id String @id @default(cuid())
 organizationId String
 organization GrantOrganization @relation(fields:[organizationId],references:[id])
 email String
 role String
 projectId String?
 tokenHash String @unique
 invitedBy String
 expiresAt DateTime
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
}
model GrantProject {
 aiDrafts GrantAiDraft[]
 id String @id @default(cuid())
 organizationId String
 organization GrantOrganization @relation(fields:[organizationId],references:[id])
 title String
 funder String
 program String @default("")
 dueAt DateTime?
 currency String @default("USD")
 status String @default("DRAFT")
 version Int @default(1)
 authorId String
 document Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 access GrantProjectAccess[]
 sources GrantSource[]
 revisions GrantRevision[]
 reviews GrantReview[]
 packages GrantPackage[]
 comments GrantComment[]
 @@index([organizationId,status,dueAt])
}
model GrantProjectAccess {
 id String @id @default(cuid())
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 userId String
 @@unique([projectId,userId])
}
model GrantSource {
 id String @id @default(cuid())
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 title String
 fileName String
 mediaType String
 bytes Bytes?
 contentHash String
 chunks Json
 actorId String
 approvedBy String?
 approvedAt DateTime?
 supersedesId String? @unique
 createdAt DateTime @default(now())
 @@index([projectId,createdAt])
}
model GrantRevision {
 id String @id @default(cuid())
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 version Int
 snapshot Json
 contentHash String
 actorId String
 reason String
 createdAt DateTime @default(now())
 @@unique([projectId,version])
}
model GrantReview {
 id String @id @default(cuid())
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 reviewerId String
 contentHash String
 approved Boolean
 reason String
 createdAt DateTime @default(now())
 @@unique([projectId,contentHash,reviewerId])
}
model GrantPackage {
 id String @id @default(cuid())
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 projectVersion Int
 contentHash String
 manifest Json
 docx Bytes
 pdf Bytes
 archive Bytes
 frozenBy String
 submittedAt DateTime?
 receiptReference String?
 receiptBytes Bytes?
 receiptHash String?
 createdAt DateTime @default(now())
 @@unique([projectId,projectVersion])
}
model GrantComment {
 id String @id @default(cuid())
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 actorId String
 body String
 taskId String?
 createdAt DateTime @default(now())
 @@index([projectId,createdAt])
}
model GrantMutation {
 id String @id
 actorId String
 organizationId String
 action String
 inputHash String
 response Json
 createdAt DateTime @default(now())
}
model GrantNotification {
 id String @id @default(cuid())
 userId String
 organizationId String
 projectId String?
 title String
 readAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId,readAt,createdAt])
}

model GrantAiDraft {
 id String @id @default(cuid())
 organizationId String
 projectId String
 project GrantProject @relation(fields:[projectId],references:[id])
 actorId String
 task String
 sectionId String?
 instructions String
 baseVersion Int
 sourceSnapshot Json
 sourceHash String
 status String @default("PENDING")
 output Json?
 providerRef String?
 model String?
 inputTokens Int?
 outputTokens Int?
 costUsd Decimal? @db.Decimal(12,6)
 error String?
 reviewedById String?
 reviewNotes String?
 appliedVersion Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,createdAt])
 @@index([projectId,status])
}

model GrantSubmissionReceipt {
 id String @id @default(cuid())
 projectId String
 packageId String
 actorId String
 fileName String
 mediaType String
 bytes Bytes
 contentHash String
 note String
 createdAt DateTime @default(now())
 @@index([projectId,packageId,createdAt])
}
