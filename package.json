{
  "name": "proposal-grant-development-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/server.mjs dev",
    "build": "next build",
    "start": "node scripts/server.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "demo-data:load": "node scripts/load-demo-data.cjs",
    "demo-data:verify": "node scripts/load-demo-data.cjs --verify",
    "test:grants:isolated": "node scripts/test-grants-isolated.cjs",
    "test:restore": "node scripts/verify-restore.cjs"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "next-auth": "^4.24.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.16.0",
    "cookie": "0.7.2",
    "uuid": "11.1.1"
  }
}
